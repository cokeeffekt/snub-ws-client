{
  "name": "snub-ws-client",
  "version": "5.0.0",
  "description": "Websocket client for snub-ws",
  "main": "dist/snub-ws-client.cjs.js",
  "module": "dist/snub-ws-client.esm.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/snub-ws-client.esm.js",
      "require": "./dist/snub-ws-client.cjs.js"
    },
    "./worker": "./dist/snub-ws-client.worker.js",
    "./dist/snub-ws-client.worker.js": "./dist/snub-ws-client.worker.js",
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "redis": "docker run --rm --name redis-untap -p 6379:6379 redis:4.0-alpine",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "rollup -c --watch",
    "sample": "concurrently \"npm run redis\" \"sleep 2 && node sample/server.cjs\" \"rollup -c --watch\" --kill-others",
    "publish": "npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cokeeffekt/snub-ws-client.git"
  },
  "author": "Patrik Hartwig",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cokeeffekt/snub-ws-client/issues"
  },
  "homepage": "https://github.com/cokeeffekt/snub-ws-client#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "concurrently": "^5.1.0",
    "prettier": "^2.3.1",
    "rollup": "^4.24.3",
    "rollup-plugin-copy": "^3.5.0",
    "snub": "^5.0.0",
    "snub-ws": "^4.1.0",
    "static-server": "^2.2.1",
    "ws": "^7.2.1"
  }
}
